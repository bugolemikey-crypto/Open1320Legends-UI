# SSH target for the Nitto 1320 Legends backend VPS.
SIDECAR_SSH_HOST=15.204.114.140
SIDECAR_SSH_PORT=22
SIDECAR_SSH_USER=ubuntu
SIDECAR_SSH_KEY=/home/you/.ssh/id_rsa
# Only needed if your private key is passphrase-protected.
SIDECAR_SSH_KEY_PASSPHRASE=

# systemd unit to read via `journalctl -u <unit>`.
SIDECAR_SYSTEMD_UNIT=nitto-backend.service

# How often `watch`/`run` re-pull, in milliseconds.
SIDECAR_POLL_INTERVAL_MS=60000

# How many lines to backfill on the very first pull (no cursor saved yet).
SIDECAR_BACKFILL_LINES=1000

# Where cursors.json and <unit>.ndjson are stored locally.
SIDECAR_DATA_DIR=./data

# How often the `run` dashboard's status sidebar auto-refreshes, in milliseconds.
SIDECAR_STATS_INTERVAL_MS=15000

# Path to your local Open1320Legends deploy.sh (or deploy.ps1 on Windows).
# Leave blank to disable the "Run deploy script" action in the dashboard menu.
SIDECAR_DEPLOY_SCRIPT=
# Working directory to run it from. Defaults to the script's own directory.
SIDECAR_DEPLOY_CWD=
